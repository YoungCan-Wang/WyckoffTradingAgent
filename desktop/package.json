{
  "name": "wyckoff-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Wyckoff 读盘室桌面端",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "start:debug": "electron . --inspect",
    "test": "node --test test/*.test.js",
    "build:py": "../scripts/build_python_ipc.sh",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "38.2.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.youngcan.wyckoff",
    "productName": "Wyckoff",
    "icon": "build/icon.png",
    "files": [
      "src/**/*",
      "!test/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist/python/wyckoff-ipc",
        "to": "wyckoff-ipc"
      }
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
