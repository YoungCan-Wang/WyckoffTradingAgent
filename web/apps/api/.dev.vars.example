UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-local-development-token
CHAT_TOOL_APPROVAL_SECRET=replace-with-a-dedicated-random-approval-secret
AGENT_SANDBOX_ENABLED=false
AGENT_SANDBOX_TIMEOUT_MS=60000
AGENT_RUN_TTL_SECONDS=3600
SANDBOX_BRIDGE_URL=https://your-sandbox-bridge.vercel.app/api/sandbox-run
SANDBOX_BRIDGE_SECRET=replace-with-a-random-bridge-secret
# Only needed for the Node bridge's manual real-sandbox smoke test.
VERCEL_TEAM_ID=team_xxx
VERCEL_PROJECT_ID=prj_xxx
VERCEL_TOKEN=replace-with-vercel-access-token

# Member agent lane (off unless both are set and the user is listed). Local only: http is allowed on loopback.
AGENT_SERVICE_URL=http://127.0.0.1:18080
AGENT_SERVICE_TOKEN=replace-with-a-random-shared-token
# Comma-separated user ids; * = every active planet member (development only).
AGENT_LANE_USERS=
# Python-service tools for members in the reading room (off unless the service is configured and the user is listed).
# Comma-separated user ids; * = every active planet member. Independent from AGENT_LANE_USERS.
AGENT_TOOLS_USERS=
