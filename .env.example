# Supabase Configuration (Optional — 不配置时持仓数据存本地 SQLite，配置后多设备云同步)
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key
# Step4 脚本建议配置 service role（USER_LIVE 读写）
SUPABASE_SERVICE_ROLE_KEY=

# Feishu Webhook (Optional)
FEISHU_WEBHOOK_URL=

# TickFlow (Optional, for data source)
# 免费模式无需 key，仅支持历史日K线；完整模式支持实时行情+分钟K线+财务数据
TICKFLOW_API_KEY=
TICKFLOW_TIMEOUT_SECONDS=12
TICKFLOW_MAX_RETRIES=3
TICKFLOW_RETRY_BACKOFF_SECONDS=1.5

# Tushare Pro (Optional, for data source)
TUSHARE_TOKEN=

# LLM (for step3 / step4)
# 默认 provider：gemini / openai / openai_compatible / zhipu / deepseek / qwen / volcengine
DEFAULT_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# 其他厂商 API Key（按需配置，未配置自动跳过）
OPENAI_API_KEY=
OPENAI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
ZHIPU_API_KEY=
ZHIPU_MODEL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=
VOLCENGINE_API_KEY=
VOLCENGINE_MODEL=

# 低成本/快速模型通道（仅用于合规版简报、摘要、格式整理等低风险任务）
# 通用 OpenAI-compatible 便宜模型通道（LongCat / DeepSeek / Minimax 等）
EFFICIENCY_API_KEY=
EFFICIENCY_MODEL=
EFFICIENCY_BASE_URL=

# Step4 private portfolio delivery
# 定时任务只执行该用户（必须是 Supabase Auth 的 user_id）
SUPABASE_USER_ID=
TG_BOT_TOKEN=
TG_CHAT_ID=
# 可选兜底：若 USER_LIVE:<user_id> 不可用则使用此 JSON
MY_PORTFOLIO_STATE=

# Step3 RAG 防雷（可选，未配置 key 自动跳过）
RAG_VETO_ENABLED=1
RAG_NEGATIVE_KEYWORDS=
RAG_TIMEOUT=12
RAG_MAX_WORKERS=6
RAG_NEWS_LOOKBACK_DAYS=7
RAG_MAX_RESULTS=5
# CLI 浏览器研究：附着本机 Chrome CDP（默认 9222）。先启动带调试端口的 Chrome。
WYCKOFF_BROWSER_CDP_URL=http://127.0.0.1:9222
# 搜索引擎：duckduckgo（默认，自动化更稳）或 bing
WYCKOFF_BROWSER_SEARCH_ENGINE=duckduckgo

# Step2 -> Step3 AI 候选收口
# legacy_full_hits: 默认回归 88b4ca3（L4命中全量进 Step3）
# topdown_quota: 使用 Top-Down 配额分流（Trend/Accum）
FUNNEL_AI_SELECTION_MODE=tradeable_l4
# legacy_compact: 默认回归 88b4ca3 漏斗卡片
# verbose: 新版详细卡片
FUNNEL_CARD_STYLE=legacy_compact
# 漏斗卡形态/旁路/主线名单；0=全部列出（飞书超长由 split_lark_md 拆成多卡，禁止为单气泡再截断）
FUNNEL_TRACKING_SHAPE_DISPLAY_LIMIT=0
FUNNEL_BYPASS_DISPLAY_LIMIT=0
FUNNEL_MAINLINE_DISPLAY_LIMIT=0
# 影子账本（paper ledger）总开关，默认关。
# 启用前须先 apply supabase/migrations/20260825_shadow_ledger.sql 建好 shadow_* 五张表，
# 否则每次运行只会记一行 failed_soft。它只写 USER_SHADOW:*，不碰 USER_LIVE 与 Step4。
SHADOW_LEDGER_ENABLED=0
# EVR 开关策略：
# all_regimes(默认): 各市场水温都开启
# cold_only: 仅 RISK_OFF/CRASH 开启
# respect_cfg: 使用 FunnelConfig 当前配置
# off: 全关闭
FUNNEL_EVR_POLICY=all_regimes
# Backtest regime 仓控：RISK_ON 最近样本下只保留最强候选更稳
# 共享漏斗策略优先读取 FUNNEL_REGIME_*，未配置时兼容读取 BACKTEST_REGIME_*
BACKTEST_REGIME_RISK_ON_POSITION_RATIO=0.25
BACKTEST_REGIME_NEUTRAL_POSITION_RATIO=0.5
BACKTEST_REGIME_BEAR_REBOUND_POSITION_RATIO=0.25
# 质量达标候选统一竞争；Trend/Accum 仅保留为 dynamic shadow 的研究分布
FUNNEL_AI_TOTAL_CAP=8
FUNNEL_AI_MAX_PER_SECTOR=2
FUNNEL_AI_RISK_ON_TREND=5
FUNNEL_AI_RISK_ON_ACCUM=1
FUNNEL_AI_RISK_OFF_TREND=0
FUNNEL_AI_RISK_OFF_ACCUM=0
FUNNEL_AI_NEUTRAL_TREND=5
FUNNEL_AI_NEUTRAL_ACCUM=1
FUNNEL_AI_MAX_TREND_L3_FILL=0
FUNNEL_AI_MAX_ACCUM_L3_FILL=0

# 动态影子评分：只授予 Step3 复核资格，不直接生成推荐或买单。
# 晋级默认关闭：HEALTHY 判据无正向前瞻证据（复算 scripts/evaluate_capital_context_alpha.py）。
# 影子分仍照算照记（score_only），只是不占 Step3 席位。
FUNNEL_DYNAMIC_SHADOW_PROMOTION=0
FUNNEL_DYNAMIC_SHADOW_PROMOTION_CAP=1
FUNNEL_DYNAMIC_SHADOW_CONTEXT_CANDIDATES=150
FUNNEL_DYNAMIC_SHADOW_HORIZON=5
FUNNEL_DYNAMIC_SHADOW_MIN_BASE_SCORE=65
FUNNEL_DYNAMIC_SHADOW_MIN_SCORE=75
FUNNEL_DYNAMIC_SHADOW_MIN_SAMPLES=30
FUNNEL_DYNAMIC_SHADOW_MIN_SPRINGBOARD=2
# 资金数据可能只覆盖少数股票，默认作为加分而非硬门槛；设为 1 可强制要求个股资金证据。
FUNNEL_DYNAMIC_SHADOW_REQUIRE_STOCK_CAPITAL=0

# 资金佐证取数覆盖面。六个资金源都是按交易日整表拉一次、本地按代码匹配，Tushare 调用
# 次数与标的数无关；但命中的资金片段会写进 features_json（中位 570B/行），是 Supabase
# 存储成本。实测每日不重复候选中位 116、p90 148，150 覆盖 90% 的交易日，够攒样本又不
# 为尾部低分候选付存储。需与 FUNNEL_DYNAMIC_SHADOW_CONTEXT_CANDIDATES 保持一致。
FUNNEL_EXTERNAL_CAPITAL_MAX_SYMBOLS=150


# 弱市流动性门槛（默认比主代码更温和，避免把弹性票一刀切）
FUNNEL_PANIC_REPAIR_MIN_AVG_AMOUNT_WAN=7000
FUNNEL_RISK_OFF_MIN_AVG_AMOUNT_WAN=8000
FUNNEL_RISK_OFF_DEEP_MIN_AVG_AMOUNT_WAN=10000
FUNNEL_CRASH_MIN_AVG_AMOUNT_WAN=12000

# Step3 报告风格：当前仅支持 v3_three_camp（三阵营模式）
# legacy_dual_pool / segmented_tracks 等旧口径已禁用，设置后会抛 RuntimeError
STEP3_REPORT_STYLE=v3_three_camp
# 三阵营模式下分轨默认开启；设为 0 可关闭，保持单篇输出
STEP3_SPLIT_BY_TRACK=0
# Step3 总上下文上限；跨日 VALIDATED 默认优先占最多 3 席
STEP3_MAX_AI_INPUT=5
STEP3_DEFAULT_CONTEXT_CAP=5
# 并入 Step3 复核池的跨日确认候选上限。
# 必须 >0：LLM 的起跳板硬门槛只放行 confirmed，而漏斗当日选中的全是 pending 触发，
# 设为 0 会让研报第三阵营恒空。
STEP3_CONFIRMED_REVIEW_CAP=3
STEP3_ENABLE_COMPRESSION=1
STEP3_MAX_PER_INDUSTRY=5
STEP3_MAX_UPSTREAM_FILL=0
STEP3_RESPECT_UPSTREAM_PRIORITY=0
STEP3_ENABLE_RAG_VETO=0
# Step3 合规观察简报（与主研报分开发送）
STEP3_SEND_COMPLIANCE_BRIEF=1
STEP3_COMPLIANCE_FOCUS_LIMIT=5
# Step3 预演模式：只展示模型输入，不调用模型
STEP3_SKIP_LLM=0
# 定时任务可选：跳过 Step4 再平衡（用于测试/预演）
DAILY_JOB_SKIP_STEP4=0

# Step4 OMS 风控增强
STEP4_ATR_PERIOD=14
STEP4_ATR_MULTIPLIER=2.0
STEP4_ATR_SLIPPAGE_FACTOR=0.25
STEP4_MAX_WORKERS=8
# 买入动作(PROBE/ATTACK)灾难止损地板（默认 -12%；日常用结构/时间管理）
STEP4_BUY_HARD_STOP_ENABLED=1
STEP4_BUY_HARD_STOP_PCT=5.0
# 漏斗送审前的结构止损距离上限，独立于 OMS 灾难止损
FUNNEL_MAX_STRUCTURE_STOP_PCT=12.0
# 单 SOS 仅观察（标准回放：10日中位 -3.20%/胜率 40%）；设 0 放开后由 PURE_SOS_MIN_ABC 兜底
FUNNEL_LOSS_GUARD_PURE_SOS_OBSERVE_ONLY=1
STEP4_BUY_STOP_MODE=floor
# 联动实测（水温 × 严格候选，54 个交易日）：NEUTRAL 超额 -4.35pct（12 天仅 3 天为正，
# bootstrap CI [-6.80,-2.07] 不跨 0）故禁买；BEAR_REBOUND +4.08pct(4/4)、RISK_ON +6.07pct(3/3)
# 故豁免。改后放行档超额由 -4.62pct 转为 +4.93pct，两个 CI 不重叠。
STEP4_BUY_BLOCK_REGIMES=UNKNOWN,NEUTRAL,PANIC_REPAIR,RISK_OFF,CRASH,BLACK_SWAN
# 从禁买名单豁免（只作用于下单闸门，不影响 AI 复核/推荐写入）。留空=沿用全部禁买。
STEP4_BUY_ALLOW_REGIMES=BEAR_REBOUND
# 有离场工单连续多日未执行时冻结新开仓（只拦 PROBE/ATTACK，不影响 EXIT/TRIM/HOLD）
# 持仓已跌破止损却连续多日未离场时，禁止 ATTACK 重仓（小额 PROBE 仍放行）
STEP4_BLOCK_BUY_ON_STALE_EXIT=1
# 单票资金上限（满足“Top3 单票最多 20%~30%”的约束）
STEP4_PROBE_BUDGET_LIMIT=0.10
# PANIC_REPAIR_CONFIRMED 仅允许更小的试探仓
STEP4_REPAIR_PROBE_BUDGET_LIMIT=0.05
STEP4_ATTACK_BUDGET_LIMIT=0.20
# Step3 对 Step4 候选的作用：shadow=研报只供人读、不参与拦截（默认）；
# veto_only=允许 LLM 从已过规则护栏的候选里剔除逻辑破产。
# LLM 输出受模型选型与采样随机性影响、无法回测复现，故默认不授予拦截权；
# 规则护栏(confirmed)始终是真正的硬门槛。
STEP4_AI_CANDIDATE_POLICY=shadow
# 与生产执行纪律保持一致：默认每个交易日最多新增一只；收益仍须由完整样本外回测验证
STEP4_MAX_NEW_BUYS_NEUTRAL=1

# Funnel 性能参数；TickFlow 可用时优先使用批量日K（120次/分、200标的/次）
FUNNEL_TRADING_DAYS=320
FUNNEL_ENABLE_TICKFLOW_BATCH=1
FUNNEL_ENFORCE_TARGET_TRADE_DATE=1
FUNNEL_DATA_FRESHNESS_HARD_FAIL=1
FUNNEL_EXECUTOR_MODE=thread
FUNNEL_MAX_WORKERS=8
FUNNEL_BATCH_SIZE=200
FUNNEL_BATCH_SLEEP=0.55
FUNNEL_BATCH_TIMEOUT=420
FUNNEL_FETCH_TIMEOUT=45
FUNNEL_SOCKET_TIMEOUT=20
FUNNEL_FETCH_RETRIES=2
FUNNEL_RETRY_BASE_DELAY=1.0

# Funnel 真实策略参数（FUNNEL_CFG_* -> FunnelConfig）
FUNNEL_CFG_MIN_MARKET_CAP_YI=20.0
FUNNEL_CFG_MIN_AVG_AMOUNT_WAN=5000.0
FUNNEL_CFG_AMOUNT_AVG_WINDOW=20
FUNNEL_CFG_MA_SHORT=50
FUNNEL_CFG_MA_LONG=200
FUNNEL_CFG_MA_HOLD=20
FUNNEL_CFG_BENCH_DROP_DAYS=3
FUNNEL_CFG_BENCH_DROP_THRESHOLD=-2.0
FUNNEL_CFG_RS_WINDOW_LONG=10
FUNNEL_CFG_RS_WINDOW_SHORT=3
FUNNEL_CFG_RS_MIN_LONG=0.0
FUNNEL_CFG_RS_MIN_SHORT=0.0
FUNNEL_CFG_ENABLE_RS_FILTER=1
FUNNEL_CFG_ENABLE_RPS_FILTER=1
FUNNEL_CFG_RPS_WINDOW_FAST=50
FUNNEL_CFG_RPS_WINDOW_SLOW=120
FUNNEL_CFG_RPS_FAST_MIN=75.0
FUNNEL_CFG_RPS_SLOW_MIN=70.0
FUNNEL_CFG_REQUIRE_BENCH_LATEST_ALIGNMENT=0
FUNNEL_CFG_TOP_N_SECTORS=5
FUNNEL_CFG_SECTOR_SUPER_STRENGTH_QUANTILE=0.90
FUNNEL_CFG_SPRING_SUPPORT_WINDOW=60
FUNNEL_CFG_SPRING_VOL_RATIO=1.0
FUNNEL_CFG_SPRING_TR_MAX_RANGE_PCT=30.0
FUNNEL_CFG_SPRING_TR_MAX_DRIFT_PCT=12.0
FUNNEL_CFG_LPS_LOOKBACK=3
FUNNEL_CFG_LPS_MA=20
FUNNEL_CFG_LPS_MA_TOLERANCE=0.02
FUNNEL_CFG_LPS_VOL_DRY_RATIO=0.35
FUNNEL_CFG_LPS_VOL_REF_WINDOW=60
# Creek/LPS 与跨信号时序仍为研究开关，生产默认关闭；Backtest Grid 的 D/E 组会显式开启。
FUNNEL_CFG_LPS_CREEK_CONFIRMATION_ENABLED=0
FUNNEL_CFG_LPS_CREEK_LOOKBACK=60
FUNNEL_CFG_LPS_CREEK_BREAKOUT_LOOKBACK=15
FUNNEL_CFG_LPS_CREEK_SWING_WINDOW=3
FUNNEL_CFG_LPS_CREEK_BREAKOUT_PCT=0.5
FUNNEL_CFG_LPS_CREEK_HOLD_TOLERANCE_PCT=2.0
FUNNEL_CFG_LPS_CREEK_MAX_RISE_PCT_PER_BAR=0.1
FUNNEL_CFG_SIGNAL_SEQUENCE_BONUS_ENABLED=0
FUNNEL_CFG_SIGNAL_SEQUENCE_LOOKBACK=12
FUNNEL_CFG_SIGNAL_SEQUENCE_SCORE_BONUS=0.5
# 触发器阈值的水温分层研究开关；Backtest Grid 的 C/E 组会显式开启。
FUNNEL_CFG_REGIME_TRIGGER_PROFILES_ENABLED=0
FUNNEL_CFG_REGIME_RISK_ON_VOLUME_MULTIPLIER=1.15
FUNNEL_CFG_REGIME_DEFENSIVE_VOLUME_MULTIPLIER=0.85
FUNNEL_CFG_REGIME_REPAIR_VOLUME_MULTIPLIER=0.90
FUNNEL_CFG_EVR_LOOKBACK=3
FUNNEL_CFG_EVR_VOL_RATIO=1.6
FUNNEL_CFG_EVR_VOL_WINDOW=20
FUNNEL_CFG_EVR_MAX_DROP=2.0
FUNNEL_CFG_GLOBAL_ENTRY_MAX_BIAS_200=25.0
FUNNEL_CFG_EVR_CONFIRM_DAYS=1
FUNNEL_CFG_EVR_CONFIRM_ALLOW_BREAK_PCT=0.0
FUNNEL_CFG_ENABLE_EVR_TRIGGER=0
FUNNEL_CFG_DIST_UPTHRUST_ENABLED=1
FUNNEL_CFG_DIST_UPTHRUST_LOOKBACK=60
FUNNEL_CFG_DIST_UPTHRUST_BREAKOUT_PCT=1.0
FUNNEL_CFG_DIST_UPTHRUST_CLOSE_BACK_PCT=0.3
FUNNEL_CFG_DIST_UPTHRUST_UPPER_SHADOW_RATIO=0.35
FUNNEL_CFG_DIST_UPTHRUST_VOL_RATIO=1.5
FUNNEL_CFG_DIST_UPTHRUST_MIN_BIAS_200_PCT=15.0

# Step0: 大盘广度与水温
FUNNEL_BREADTH_MA_WINDOW=20
FUNNEL_BREADTH_RISK_OFF_PCT=20.0
FUNNEL_BREADTH_RISK_ON_PCT=60.0
FUNNEL_BREADTH_RISK_ON_DELTA=0.0
FUNNEL_BREADTH_CLIFF_DROP_PCT=-10.0
FUNNEL_DAILY_BREADTH_REPAIR_PCT=60.0
FUNNEL_DAILY_BREADTH_WEAK_PCT=35.0
FUNNEL_PANIC_REPAIR_MAIN_REBOUND_PCT=0.8
FUNNEL_PANIC_REPAIR_SMALL_REBOUND_PCT=1.5
FUNNEL_PANIC_REPAIR_CONFIRM_MAIN_PCT=0.0
FUNNEL_PANIC_REPAIR_CONFIRM_BREADTH_PCT=50.0

# 定时任务交易日口径（北京时间）：
# 17:00-23:59 -> 目标日 T
# 00:00-16:59 -> 目标日 T-1

# 交易日历与截面日期严格对齐
ALLOW_APPROX_TRADE_CALENDAR=0
ENFORCE_TARGET_TRADE_DATE=0

# 日线延迟时的实时快照补偿（默认开启）
SPOT_SNAPSHOT_TTL_SECONDS=20
FUNNEL_ENABLE_SPOT_PATCH=1
FUNNEL_SPOT_PATCH_RETRIES=2
FUNNEL_SPOT_PATCH_SLEEP=0.2
STEP3_ENABLE_SPOT_PATCH=1
STEP3_SPOT_PATCH_RETRIES=2
STEP3_SPOT_PATCH_SLEEP=0.2
STEP4_ENABLE_SPOT_PATCH=1
STEP4_SPOT_PATCH_RETRIES=2
STEP4_SPOT_PATCH_SLEEP=0.3

# 按买点类型禁买（留空=不过滤，默认）。
# 生产回测（66 交易日/124 笔/含真实成本）按买点归因：evr -2.30%(胜率45.8%)、
# sos -4.92%(33.3%，中位 -11.04%)、spring +0.05%(57.5%)。变体 G（剔除 evr+sos）
# 在每个指标上优于基线：总收益 -15.82%→-6.31%、回撤 -23.91%→-13.14%、夏普 -2.066→-1.207。
# 默认留空是因为该证据只覆盖 2026-05~08 单段行情；拿到跨周期证据后再开启。
STEP4_BLOCK_BUY_SIGNAL_TYPES=
